<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#99000000">

    <!-- macOS风格应用面板 -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/drawer_margin_sides"
        android:layout_marginEnd="@dimen/drawer_margin_sides"
        android:layout_marginTop="@dimen/drawer_margin_vertical"
        android:layout_marginBottom="@dimen/drawer_margin_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:cardBackgroundColor="@color/overlay_surface"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- 顶部栏 -->
            <LinearLayout
                android:id="@+id/topBar"
                android:layout_width="match_parent"
                android:layout_height="@dimen/top_bar_height"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp"
                app:layout_constraintTop_toTopOf="parent">

                <!-- 返回按钮 -->
                <ImageView
                    android:id="@+id/btnBack"
                    android:layout_width="@dimen/top_control_size"
                    android:layout_height="@dimen/top_control_size"
                    android:src="@drawable/ic_back"
                    android:scaleType="centerInside"
                    android:padding="6dp"
                    android:tint="@color/on_surface"
                    android:background="@drawable/bg_back_button"
                    android:contentDescription="返回" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="所有应用"
                    android:textSize="17sp"
                    android:textColor="@color/on_surface"
                    android:layout_marginStart="16dp" />

            </LinearLayout>

            <!-- 搜索框（与首页搜索胶囊同款玻璃风格） -->
            <LinearLayout
                android:id="@+id/searchBar"
                android:layout_width="match_parent"
                android:layout_height="@dimen/top_bar_height"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_glass_pill"
                android:elevation="4dp"
                android:paddingHorizontal="20dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/topBar">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_search"
                    android:tint="@color/muted"
                    android:contentDescription="搜索" />

                <EditText
                    android:id="@+id/searchInput"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:background="@null"
                    android:hint="搜索应用..."
                    android:textSize="15sp"
                    android:textColor="@color/on_surface"
                    android:textColorHint="@color/muted"
                    android:singleLine="true"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:paddingVertical="0dp" />

            </LinearLayout>

            <!-- 应用网格（macOS风格，大图标） -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvAllApps"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="16dp"
                android:paddingHorizontal="24dp"
                android:clipToPadding="false"
                app:layout_constraintTop_toBottomOf="@id/searchBar"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
