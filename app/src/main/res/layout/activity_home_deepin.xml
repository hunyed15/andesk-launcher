<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_wallpaper">

    <!-- 顶部状态条（Deepin 风格：左侧搜索，右侧时钟/天气/控制） -->
    <LinearLayout
        android:id="@+id/deepinTopBar"
        android:layout_width="0dp"
        android:layout_height="@dimen/top_bar_height"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/top_bar_margin"
        android:layout_marginTop="@dimen/top_bar_margin"
        android:layout_marginHorizontal="@dimen/top_bar_margin"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 搜索胶囊 -->
        <LinearLayout
            android:id="@+id/searchCapsule"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/top_bar_height"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_glass_pill"
            android:elevation="4dp"
            android:paddingHorizontal="20dp">
            <ImageView
                android:layout_width="20dp" android:layout_height="20dp"
                android:src="@drawable/ic_search" android:tint="@color/muted"
                android:contentDescription="搜索" />
            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="搜索应用" android:textSize="15sp"
                android:textColor="@color/muted" android:layout_marginStart="12dp" />
        </LinearLayout>

        <Space
            android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

        <!-- 时间 / 日期 -->
        <TextView
            android:id="@+id/tvTime" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="14:32"
            android:textSize="18sp" android:textColor="@color/on_surface"
            android:fontFamily="sans-serif-medium" android:textStyle="bold" />
        <TextView
            android:id="@+id/tvDate" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="06月15日 周一"
            android:textSize="12sp" android:textColor="@color/muted"
            android:layout_marginStart="10dp" android:layout_marginEnd="12dp" />

        <!-- 天气摘要（紧凑） -->
        <ImageView
            android:id="@+id/weatherIcon" android:layout_width="26dp"
            android:layout_height="26dp" android:scaleType="fitCenter"
            android:layout_marginEnd="4dp" android:contentDescription="天气" />
        <TextView
            android:id="@+id/weatherTemp" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="19°~28°"
            android:textSize="14sp" android:textColor="@color/on_surface"
            android:fontFamily="sans-serif-medium" />
        <TextView
            android:id="@+id/weatherCity" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="宿迁市"
            android:textSize="12sp" android:textColor="@color/muted"
            android:layout_marginStart="6dp" android:layout_marginEnd="8dp" />
        <TextView
            android:id="@+id/weatherDesc" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="晴"
            android:textSize="12sp" android:textColor="@color/muted"
            android:layout_marginEnd="14dp" />

        <!-- 控制区（40dp 触控目标） -->
        <LinearLayout
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView
                android:id="@+id/btnWifiSettings"
                android:layout_width="@dimen/top_control_size" android:layout_height="@dimen/top_control_size"
                android:src="@drawable/ic_wifi" android:scaleType="fitCenter"
                android:padding="@dimen/top_control_padding" android:tint="@color/muted"
                android:contentDescription="WiFi设置" />
            <LinearLayout
                android:id="@+id/btnBatterySettings"
                android:layout_width="wrap_content" android:layout_height="@dimen/top_control_size"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/top_control_padding"
                android:contentDescription="电池设置">
                <ImageView
                    android:layout_width="24dp" android:layout_height="24dp"
                    android:src="@drawable/ic_battery" android:tint="@color/muted"
                    android:scaleType="fitCenter" />
                <TextView
                    android:id="@+id/tvBatteryPercent"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="--" android:textSize="@dimen/text_xl"
                    android:textColor="@color/muted" android:fontFamily="sans-serif-medium"
                    android:layout_marginStart="4dp" />
            </LinearLayout>
            <ImageView
                android:id="@+id/btnCleanup"
                android:layout_width="@dimen/top_control_size" android:layout_height="@dimen/top_control_size"
                android:src="@drawable/ic_rocket" android:scaleType="centerInside"
                android:padding="@dimen/top_control_padding" android:tint="@color/muted"
                android:contentDescription="清理内存" />
            <ImageView
                android:id="@+id/btnSettings"
                android:layout_width="@dimen/top_control_size" android:layout_height="@dimen/top_control_size"
                android:src="@drawable/ic_settings" android:scaleType="centerInside"
                android:padding="@dimen/top_control_padding" android:tint="@color/muted"
                android:contentDescription="设置" />
            <ImageView
                android:id="@+id/btnThemeToggle"
                android:layout_width="@dimen/top_control_size" android:layout_height="@dimen/top_control_size"
                android:src="@drawable/ic_theme_dark" android:scaleType="centerInside"
                android:padding="@dimen/top_control_padding" android:tint="@color/muted"
                android:contentDescription="切换主题" />
            <ImageView
                android:id="@+id/btnPowerMenu"
                android:layout_width="@dimen/top_control_size" android:layout_height="@dimen/top_control_size"
                android:src="@drawable/ic_power" android:scaleType="centerInside"
                android:padding="@dimen/top_control_padding" android:tint="@color/muted"
                android:contentDescription="电源" />
        </LinearLayout>
    </LinearLayout>

    <!-- 主内容区：全屏应用分页 -->
    <LinearLayout
        android:id="@+id/deepinContent"
        android:layout_width="0dp" android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:layout_marginHorizontal="@dimen/home_margin_sides"
        app:layout_constraintTop_toBottomOf="@id/deepinTopBar"
        app:layout_constraintBottom_toTopOf="@id/deepinDock"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPager"
            android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/pageIndicator"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center"
            android:layout_marginTop="16dp">
            <TextView
                android:id="@+id/dot1" android:layout_width="@dimen/page_indicator_size"
                android:layout_height="@dimen/page_indicator_size"
                android:gravity="center" android:text="1"
                android:textSize="@dimen/page_indicator_text_size"
                android:textColor="@color/on_surface"
                android:background="@drawable/bg_page_indicator_active"
                android:layout_marginEnd="@dimen/page_indicator_spacing" />
            <TextView
                android:id="@+id/dot2" android:layout_width="@dimen/page_indicator_size"
                android:layout_height="@dimen/page_indicator_size"
                android:gravity="center" android:text="2"
                android:textSize="@dimen/page_indicator_text_size"
                android:textColor="@color/muted"
                android:background="@drawable/bg_page_indicator"
                android:layout_marginEnd="@dimen/page_indicator_spacing" />
            <TextView
                android:id="@+id/dot3" android:layout_width="@dimen/page_indicator_size"
                android:layout_height="@dimen/page_indicator_size"
                android:gravity="center" android:text="3"
                android:textSize="@dimen/page_indicator_text_size"
                android:textColor="@color/muted"
                android:background="@drawable/bg_page_indicator"
                android:layout_marginEnd="@dimen/page_indicator_spacing" />
            <TextView
                android:id="@+id/dot4" android:layout_width="@dimen/page_indicator_size"
                android:layout_height="@dimen/page_indicator_size"
                android:gravity="center" android:text="4"
                android:textSize="@dimen/page_indicator_text_size"
                android:textColor="@color/muted"
                android:background="@drawable/bg_page_indicator" />
        </LinearLayout>
    </LinearLayout>

    <!-- 底部居中的 Deepin Dock -->
    <LinearLayout
        android:id="@+id/deepinDock"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:background="@drawable/bg_glass_dock"
        android:elevation="8dp"
        android:paddingHorizontal="12dp" android:paddingVertical="10dp"
        android:layout_marginBottom="@dimen/dock_bar_margin_bottom"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <ImageView
            android:id="@+id/dockIcon1" android:layout_width="56dp" android:layout_height="56dp"
            android:padding="8dp" android:scaleType="fitCenter" android:layout_marginEnd="10dp" />
        <ImageView
            android:id="@+id/dockIcon2" android:layout_width="56dp" android:layout_height="56dp"
            android:padding="8dp" android:scaleType="fitCenter" android:layout_marginEnd="10dp" />
        <ImageView
            android:id="@+id/dockIcon3" android:layout_width="56dp" android:layout_height="56dp"
            android:padding="8dp" android:scaleType="fitCenter" android:layout_marginEnd="10dp" />
        <ImageView
            android:id="@+id/dockIcon4" android:layout_width="56dp" android:layout_height="56dp"
            android:padding="8dp" android:scaleType="fitCenter" android:layout_marginEnd="10dp" />
        <View
            android:layout_width="1dp" android:layout_height="@dimen/dock_divider_height"
            android:background="@color/dock_divider" android:layout_marginHorizontal="4dp" />
        <ImageView
            android:id="@+id/btnAllApps" android:layout_width="56dp" android:layout_height="56dp"
            android:src="@drawable/ic_apps_grid" android:scaleType="centerInside"
            android:tint="@color/muted" android:contentDescription="所有应用" />
    </LinearLayout>

    <!-- 诗词/背景（Deepin 默认隐藏，HomeActivity 仍会更新其文本，避免空指针） -->
    <TextView
        android:id="@+id/tvHitokoto" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:visibility="gone" />
    <TextView
        android:id="@+id/tvHitokotoFrom" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:visibility="gone" />
    <ImageButton
        android:id="@+id/btnRefreshHitokoto" android:layout_width="0dp"
        android:layout_height="0dp" android:visibility="gone" />
    <ImageView
        android:id="@+id/weatherBgIcon" android:layout_width="0dp"
        android:layout_height="0dp" android:visibility="gone" />
    <TextView
        android:id="@+id/statusTime" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:visibility="gone" />

    <!-- Toast -->
    <TextView
        android:id="@+id/toastView" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:background="@drawable/bg_toast"
        android:textColor="@color/on_surface" android:textSize="15sp"
        android:fontFamily="sans-serif-medium" android:paddingHorizontal="32dp"
        android:paddingVertical="12dp" android:elevation="8dp" android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/deepinDock"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
